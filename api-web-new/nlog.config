<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd">
	<targets>
		<target xsi:type="File" name="allfile" fileName="C:/Logs/ApiLoggingDemo/api-
${shortdate}.log" />
		<target xsi:type="Console" name="console" layout="${level}: ${logger} ${message}" />
	</targets>
	<rules>
		<logger name="*" minlevel="Info" writeTo="console" />
		<logger name="*" minlevel="Info" writeTo="allfile" />
	</rules>
</nlog>